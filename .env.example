# LangTeam Environment Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Provider: 'ollama' (local), 'openai' (cloud), 'together' (cloud), 'hf' (cloud)
LLM_PROVIDER=ollama

# Model name (provider-specific)
# Ollama with tool support: llama3.2:latest, mistral:latest, qwen2.5-coder:latest
# Ollama without tools: codellama:latest (agents describe tools in text)
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Together: codellama/CodeLlama-34b-Instruct-hf
# HF: codellama/CodeLlama-7b-hf
# Note: Models without tool support will work but agents won't execute shell/http commands directly
LLM_MODEL=llama3.2:latest

# Model temperature (0.0 = deterministic, 1.0 = creative)
# Lower values recommended for code generation
LLM_TEMPERATURE=0.2

# ============================================================================
# Hybrid Model Configuration (Smart Routing)
# ============================================================================
# Use different models for different agent types:
# - Tool-capable agents (Backend, Frontend) use LLM_PROVIDER_TOOLS/LLM_MODEL_TOOLS
# - Text-only agents (PM, Reviewer) use LLM_PROVIDER_TEXT/LLM_MODEL_TEXT
# This optimizes cost and performance: powerful cloud models for tools, fast local models for text

# Provider for agents that need tools (Backend, Frontend)
# Leave empty to use LLM_PROVIDER above
LLM_PROVIDER_TOOLS=openai
LLM_MODEL_TOOLS=gpt-4o-mini

# Provider for agents that only need text (PM, Reviewer)
# Leave empty to use LLM_PROVIDER above
LLM_PROVIDER_TEXT=ollama
LLM_MODEL_TEXT=llama3.2:latest

# ============================================================================
# API Keys (Optional - only needed for cloud providers)
# ============================================================================
# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Together AI API key (get from https://together.ai)
TOGETHER_API_KEY=

# Hugging Face API token (get from https://huggingface.co/settings/tokens)
HF_API_TOKEN=

# Ollama base URL (customize if running Ollama on different host/port)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Team Iteration Limits
# ============================================================================
# Maximum number of PM → Backend → Frontend → Reviewer cycles
# Increase for complex projects, decrease for faster iteration
MAX_TURNS=10

# Maximum shell commands each agent can run per turn
# Increase for tool-heavy tasks, decrease for safety
MAX_SHELL_CMDS_PER_TURN=5

# ============================================================================
# Tool Configuration
# ============================================================================
# HTTP request timeout in seconds
HTTP_TIMEOUT_SECONDS=30

# Allow shell command execution (true/false)
ALLOW_SHELL=true

# Allow HTTP GET/POST requests (true/false)
ALLOW_HTTP=true

# Allow git operations (true/false)
ALLOW_GIT=true

# Allow filesystem operations (true/false)
ALLOW_FS=true

# Allow MCP server integrations (true/false)
ALLOW_MCP=true

# ============================================================================
# Memory and Learning Configuration
# ============================================================================
# Enable persistent memory and learning from mistakes (true/false)
LEARNING_ENABLED=true

# Path to SQLite database for memory storage
MEMORY_DB_PATH=./memory.db

# Number of past experiences to retrieve for context
MEMORY_RETRIEVAL_LIMIT=5

# Minimum similarity score for memory retrieval (0.0-1.0)
MEMORY_SIMILARITY_THRESHOLD=0.7

# Automatically analyze failures and extract lessons (true/false)
AUTO_LEARN_FROM_FAILURES=true

# Store successful patterns for reuse (true/false)
STORE_SUCCESS_PATTERNS=true

# ============================================================================
# Safety and Guardrails
# ============================================================================
# Sandbox directory for shell command execution
SANDBOX_DIR=./sandbox

# Projects root directory (where new project directories are created)
PROJECTS_ROOT=./projects

# Redact secrets in logs and output (true/false)
REDACT_SECRETS=true

# Require confirmation for destructive operations (true/false)
REQUIRE_CONFIRMATION=true

# ============================================================================
# Output and Logging
# ============================================================================
# Enable colored/formatted console output (true/false)
RICH_OUTPUT=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Save detailed logs to file (true/false)
SAVE_LOGS=false

# Log file path (only used if SAVE_LOGS=true)
LOG_FILE_PATH=./langteam.log

# ============================================================================
# Advanced Configuration
# ============================================================================
# Enable LangChain debug tracing (true/false)
LANGCHAIN_DEBUG=false

# Maximum tokens per LLM response (0 = no limit)
MAX_TOKENS=0

# Number of retry attempts for failed LLM calls
MAX_RETRIES=3

# Delay between retries in seconds
RETRY_DELAY=2
